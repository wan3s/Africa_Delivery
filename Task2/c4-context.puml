@startuml c4-context
!include <C4/C4_Context>

title C4 Context — Africa Delivery (MVP, 15.10.2026)

Person(buyer, "Покупатель (город)", "Смартфон до 150 USD, сеть 3G. Ищет товар, оформляет и оплачивает заказ")
Person(buyer_rural, "Покупатель (село)", "Кнопочный телефон, нет интернета. 30–40% адресуемого рынка")
Person(seller, "Продавец", "Малый бизнес. Часть работает только через мессенджер")
Person(pickup, "Сотрудник пункта выдачи", "Подтверждает факт выдачи заказа")
Person(support, "Оператор поддержки", "Ручной KYC продавцов, разбор споров, возвраты")
Person(exec, "CEO и инвестор", "Смотрят операционные показатели запуска")

System(ad, "Africa Delivery", "Маркетплейс: каталог, заказы, оплата через провайдера, уведомления, кабинеты, бэк-офис, аналитика")

System_Ext(mpesa, "M-Pesa API", "Кения. Мобильные платежи, альтернативы на рынке нет")
System_Ext(flutter, "Flutterwave API", "Нигерия. Приём платежей и выплаты продавцам")
System_Ext(paystack, "Paystack API", "Нигерия. Резервный провайдер")
System_Ext(sendbox, "Sendbox API", "Нигерия. Доставка и пункты выдачи")
System_Ext(sendy, "Sendy API", "Кения. Доставка и пункты выдачи")
System_Ext(wa, "WhatsApp Business API", "Канал для продавцов без личного кабинета")
System_Ext(sms, "SMS / USSD шлюз", "Уведомления и оформление заказа без интернета")

Rel(buyer, ad, "Ищет товары, оформляет и оплачивает заказ", "HTTPS, Android / PWA")
Rel(seller, ad, "Заводит карточки товаров, видит заказы и выплаты", "HTTPS, веб-кабинет")
Rel(pickup, ad, "Подтверждает выдачу заказа по коду", "HTTPS")
Rel(support, ad, "Проверяет продавцов, разбирает споры и возвраты", "HTTPS, бэк-офис")
Rel(exec, ad, "Смотрит дашборд: регистрации, заказы, выручка", "HTTPS")

Rel(buyer_rural, sms, "Набирает USSD-код, получает SMS", "USSD / SMS")
Rel_Back(ad, sms, "Передаёт USSD-сессии и входящие SMS")
Rel(ad, sms, "Отправляет уведомления о статусе заказа", "HTTPS API")

Rel(seller, wa, "Отправляет товары и получает заказы сообщением", "WhatsApp")
Rel_Back(ad, wa, "Передаёт входящие сообщения продавцов", "Webhook")
Rel(ad, wa, "Отправляет уведомления продавцам и покупателям", "HTTPS API")

Rel(ad, mpesa, "Инициирует списание (STK push), принимает подтверждение", "HTTPS API + webhook")
Rel(ad, flutter, "Принимает оплату и выплачивает продавцам", "HTTPS API + webhook")
Rel(ad, paystack, "Принимает оплату при недоступности основного провайдера", "HTTPS API")
Rel(ad, sendbox, "Создаёт отправление, получает статусы доставки", "HTTPS API + webhook")
Rel(ad, sendy, "Создаёт отправление, получает статусы доставки", "HTTPS API + webhook")

SHOW_LEGEND()
@enduml
